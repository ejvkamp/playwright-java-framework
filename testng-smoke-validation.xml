<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="SmokeValidationSuite">
    <test name="SmokeValidation">
        <!-- Required by ParameterizedTest's @Parameters annotation -->
        <parameter name="browser" value="firefox"/>
        <parameter name="appURL" value="https://ecommerce-playground.lambdatest.io/"/>
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>

        <classes>
            <class name="com.automation.tests.ParameterizedTest"/>
            <class name="com.automation.tests.ShadowDomTest"/>
        </classes>
    </test>
</suite>